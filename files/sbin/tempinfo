#!/bin/sh

THERMAL_PATH="/sys/class/thermal"

fmt_c() {
	[ -r "$1" ] || return 0
	awk '$0 ~ /^-?[0-9]+$/ { printf("%.1f°C", $0 / 1000); exit }' "$1" 2>/dev/null
}

cpu_temp="$(fmt_c "$THERMAL_PATH/thermal_zone0/temp")"

pon_temp=""
if [ -x /usr/sbin/ponctl ] && [ -x /usr/bin/jsonfilter ]; then
	pon_dev=""
	if [ -x /sbin/uci ]; then
		pon_dev="$(/sbin/uci -q get pon.@xpon[0].device 2>/dev/null)"
	fi

	if [ -n "$pon_dev" ]; then
		pon_json="$(/usr/sbin/ponctl --device "$pon_dev" status --json 2>/dev/null)"
	else
		pon_json="$(/usr/sbin/ponctl status --json 2>/dev/null)"
	fi

	if [ -n "$pon_json" ]; then
		pon_temp="$(printf '%s' "$pon_json" | /usr/bin/jsonfilter -q \
			-e '@.frontend.temperature_celsius' 2>/dev/null | \
			awk '$0 ~ /^-?[0-9]+([.][0-9]+)?$/ { printf("%.1f°C", $0); exit }')"
	fi
fi

out=""
[ -n "$cpu_temp" ] && out="CPU: $cpu_temp"
[ -n "$pon_temp" ] && out="${out:+$out, }PON: $pon_temp"
[ -n "$out" ] || out="No temperature info"

printf '%s' "$out"
